# Run python studio/setup.py to generate private local credentials.
# Copy this repository to the NAS; do not copy a populated library into Git.
STUDIO_BIND=127.0.0.1
STUDIO_PORT=43120
STUDIO_LIBRARY=./data/library
LRR_API_KEY=replace-with-random-key
STUDIO_PASSWORD=replace-with-a-long-password
STUDIO_WORKER_TOKEN=replace-with-a-different-random-key
# DS718+: set STUDIO_BIND to the NAS LAN IP after configuring authentication.
# STUDIO_LIBRARY=/volume1/media/library-studio
# Engine adapter settings belong on each target worker, not in the browser:
# STUDIO_SERVER=https://your-private-library
# STUDIO_TARGET=pc
# STUDIO_OUTPUT=D:/LibraryDownloads
# STUDIO_DOWNLOAD_COMMAND=["C:/path/to/headless-engine.exe","{url}","--output","{output}"]
